# Database
DATABASE_URL=postgresql://edutech:changeme@localhost:5432/edutech
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change-this-to-a-random-64-char-hex-string
# Google Sign-In (OAuth 2.0 via Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Super administrator bootstrap (used ONLY by `npm run seed` — never sent to the browser)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-to-a-long-random-password-min-12-chars

# Session cookie: Secure flag is ON by default (fail-closed). Only set
# COOKIE_SECURE=false for plain-HTTP local development — never in production.
COOKIE_SECURE=false

# Face Service
FACE_SERVICE_URL=http://localhost:8001
FACE_ENCRYPTION_KEY=

# Frontend
CORS_ORIGIN=http://localhost:5173
# Only for LAN development against a directly-exposed API (no nginx proxy).
# Production/self-host need this OFF: the frontend and /api share one origin.
ALLOW_PRIVATE_ORIGINS=false

# Secret login path (admin can change this to protect login URL; rotated paths are synced here)
VITE_LOGIN_PATH=/your-secret-login-path
# Optional standalone encryption key for sealing login path & SMS gateway secrets in PostgreSQL (falls back to HKDF(JWT_SECRET))
# LOGIN_PATH_ENCRYPTION_KEY=
# SMS_GATEWAY_ENCRYPTION_KEY=
# Set true on read-only serverless containers to skip writing .env on login path changes
# DISABLE_ENV_FILE_SYNC=false

# API
PORT=3001

# EmailJS (https://www.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Telegram Backup (Automated database backups sent to your Telegram chat or channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# License core (signed license keys + optional heartbeat)
# VITE_LICENSE_SECRET is used to sign/verify license keys — set per deployment.
# VITE_LICENSE_HEARTBEAT_URL, when set, enables online license validation.
VITE_LICENSE_SECRET=change-this-to-a-random-secret
VITE_LICENSE_HEARTBEAT_URL=https://api.yourdomain.com/api/license/heartbeat
