# Database
DATABASE_URL=postgresql://edutech:changeme@localhost:5432/edutech
DB_PASSWORD=changeme

# Auth
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Super administrator bootstrap (used ONLY by `npm run seed` — never sent to the browser)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-to-a-long-random-password-min-12-chars

# Session cookie: set to true when serving over HTTPS in production
COOKIE_SECURE=false

# Face Service
FACE_SERVICE_URL=http://localhost:8001
FACE_ENCRYPTION_KEY=

# Frontend
CORS_ORIGIN=http://localhost:5173

# Secret login path (admin can change this to protect login URL)
VITE_LOGIN_PATH=/your-secret-login-path

# API
PORT=3001

# EmailJS (https://www.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Telegram Backup (Automated database backups sent to your Telegram chat or channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
