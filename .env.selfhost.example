# Mode B — self-host .env. Copy to .env and edit before `docker compose up`.

# Postgres password (used by the api + postgres services)
DB_PASSWORD=changeme-change-me

# API JWT secret — at least 32 random characters
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Super-admin bootstrap (created on first start; change the password after)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-to-a-long-random-password-min-12-chars

# Serve over HTTPS? Set true only behind a TLS terminator.
COOKIE_SECURE=false

# Public origin of this instance (used for CORS + redirects)
CORS_ORIGIN=http://localhost

# Login path shown in the URL (protects the login route)
VITE_LOGIN_PATH=/login

# License secret — signs/verifies license keys. Must match the secret the
# frontend was built with (the compose file passes it into the build).
# Leave empty to disable licensing enforcement entirely.
LICENSE_SECRET=

# Optional: Sentry DSN for error tracking
VITE_SENTRY_DSN=
