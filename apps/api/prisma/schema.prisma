generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  super_admin
  school_admin
  teacher
  student
  hr_admin
}

model School {
  id        String   @id @default(uuid())
  name      String
  nameBn    String?  @map("name_bn")
  address   String?
  phone     String?
  email     String?
  logo      String?
  banner    String?
  bannerPosition String? @default("{\"x\":0,\"y\":0}") @map("banner_position")
  brandName String?  @map("brand_name")
  brandColor String? @default("#6366f1") @map("brand_color")
  motto     String?
  mottoBn   String?  @map("motto_bn")
  eiin      String?
  website   String?
  addressBn String?  @map("address_bn")
  sessions  String?  @default("[\"2025-26\"]")
  breaks    String?  @default("[]")
  domain    String?  @unique
  timezone  String   @default("Asia/Dhaka")
  startTime String   @default("07:30") @map("start_time")
  endTime   String   @default("14:30") @map("end_time")
  storageMode String? @default("cloud") @map("storage_mode")
  serverUrl   String? @default("") @map("server_url")
  folderName  String? @default("") @map("folder_name")
  classesData String? @default("[]") @map("classes_data")
  routinesData String? @default("[]") @map("routines_data")
  status      String   @default("active")
  plan        String   @default("basic")
  expiresAt   DateTime? @map("expires_at")
  maxStudents Int      @default(500) @map("max_students")
  maxTeachers Int      @default(50) @map("max_teachers")
  paymentStatus String @default("paid") @map("payment_status")
  billingCycle  String @default("monthly") @map("billing_cycle")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  teachers  Teacher[]
  students  Student[]
  departments Department[]
  subjects    Subject[]
  designations Designation[]
  notices      Notice[]
  noticeCategories NoticeCategory[]
  mediaObjects MediaObject[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         UserRole @default(teacher)
  schoolId     String?  @map("school_id")
  isActive     Boolean  @default(true) @map("is_active")
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  sessions Session[]

  @@index([schoolId])
  @@map("users")
}

model Teacher {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  nameEn          String   @map("name_en")
  nameBn          String?  @map("name_bn")
  gender          String?
  dob             String?
  bloodGroup      String?  @map("blood_group")
  religion        String?
  phone           String?
  email           String?
  address         String?
  nid             String?
  emergencyPhone  String?  @map("emergency_phone")
  photo           String?
  departmentId    String?  @map("department_id")
  subjectIds      String[] @default([]) @map("subject_ids")
  designation     String?
  qualification   String?
  experience      String?
  salary          Decimal?
  salaryStartDate String?  @map("salary_start_date")
  bonus           Decimal?
  overtime        Decimal?
  festivalBonus   Decimal? @map("festival_bonus")
  status          String   @default("active")
  category        String?
  joiningDate     String?  @map("joining_date")
  inTime          String?  @map("in_time")
  outTime         String?  @map("out_time")
  fatherNameEn    String?  @map("father_name_en")
  fatherNameBn    String?  @map("father_name_bn")
  fatherPhone     String?  @map("father_phone")
  fatherNid       String?  @map("father_nid")
  motherNameEn    String?  @map("mother_name_en")
  motherNameBn    String?  @map("mother_name_bn")
  motherPhone     String?  @map("mother_phone")
  guardianName    String?  @map("guardian_name")
  guardianPhone   String?  @map("guardian_phone")
  guardianRelation String? @map("guardian_relation")
  parentAddress   String?  @map("parent_address")
  signature       String?
  expertSubjects  String?  @map("expert_subjects")
  applySalaryRule Boolean? @default(false) @map("apply_salary_rule")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([email])
  @@index([schoolId, status])
  @@map("teachers")
}

model Department {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  nameBn    String?  @map("name_bn")
  head      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([name, schoolId])
  @@index([schoolId])
  @@map("departments")
}

model Subject {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  name         String
  nameBn       String?  @map("name_bn")
  departmentId String?  @map("department_id")
  departmentIds String[] @default([]) @map("department_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([name, schoolId])
  @@index([schoolId])
  @@map("subjects")
}

model Designation {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  nameBn    String?  @map("name_bn")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([name, schoolId])
  @@index([schoolId])
  @@map("designations")
}

model Student {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  nameEn        String   @map("name_en")
  nameBn        String?  @map("name_bn")
  phone         String?
  email         String?
  photo         String?
  class         String?
  section       String?
  admissionDate String?  @map("admission_date")
  status        String   @default("approved")
  fatherNameEn  String?  @map("father_name_en")
  fatherPhone   String?  @map("father_phone")
  motherNameEn  String?  @map("mother_name_en")
  motherPhone   String?  @map("mother_phone")
  district      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, class, section])
  @@map("students")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model Notice {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  title       String
  titleBn     String?   @map("title_bn")
  content     String
  contentBn   String?   @map("content_bn")
  author      String?
  authorBn    String?   @map("author_bn")
  target      String    @default("all")
  priority    String    @default("medium")
  category    String    @default("General")
  pinned      Boolean   @default(false)
  isActive    Boolean   @default(true) @map("is_active")
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  storage     String?
  /// Original localStorage record id — the idempotency key for the one-time
  /// local-data import. Unique per school, so re-imports skip instead of
  /// duplicating, and imports can never cross tenant boundaries.
  localId     String?   @map("local_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, localId])
  @@index([schoolId])
  @@index([schoolId, pinned])
  @@map("notices")
}

model NoticeCategory {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([name, schoolId])
  @@index([schoolId])
  @@map("notice_categories")
}

model MediaObject {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  /// Policy category: student_photo (<=200 KB) | institution_logo (<=5 MB) | institution_banner (<=5 MB)
  category  String
  /// Tenant-scoped private object key (schools/{schoolId}/...) — never a public URL.
  objectKey String    @unique @map("object_key")
  fileName  String    @map("file_name")
  mimeType  String    @map("mime_type")
  sizeBytes Int       @map("size_bytes")
  uploadedById String? @map("uploaded_by_id")
  /// Tombstone start. Rows are retained for the 3-year retention window after
  /// deletion; physical purge happens only after that window (see runbook).
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, category])
  @@index([deletedAt])
  @@map("media_objects")
}
