# Server-only configuration for apps/api (copy to .env — never commit .env)
# All values here are SECRET. Anything prefixed with VITE_ would be public.

# Database
DATABASE_URL=postgresql://edutech:changeme@localhost:5432/edutech
DB_PASSWORD=changeme

# Auth (JWT_SECRET: min 32 chars — generate with `openssl rand -hex 32`)
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Super administrator bootstrap (used ONLY by `npm run seed`)
# The password is stored as an Argon2id hash; plaintext exists only at seed time.
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-to-a-long-random-password-min-12-chars

# Session cookie: set to true when serving over HTTPS in production
COOKIE_SECURE=false

# CORS allowlist (exact frontend origin)
CORS_ORIGIN=http://localhost:5173

# API port
PORT=3001
